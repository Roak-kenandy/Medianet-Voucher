NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medianet_voucher
DB_USER=your_db_user
DB_PASSWORD=your_db_password_here

# Production requires unique secrets (64+ chars). Placeholders below are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Marketing ad images are served from the API host. Use /api/uploads (default) when nginx
# proxies only /api to Node. Use /uploads if nginx has a separate location for uploads.
# PUBLIC_UPLOAD_BASE_PATH=/api/uploads

# Initial admin (used by seed script only — never use defaults in production)
SEED_ADMIN_EMAIL=admin@medianet.mv
SEED_ADMIN_PASSWORD=ChangeMe@Secure123
SEED_ADMIN_NAME=System Admin

# CRM integration (required for operator account creation)
CRM_API_KEY=your_crm_api_key_here
CRM_BASE_URL=https://your-crm-host/backoffice/v2
DEFAULT_TAG_ID=your_default_tag_uuid
MEDIANET_TV_TAG_ID=your_medianet_tv_tag_uuid
DEVICE_PRODUCT_ID=your_device_product_uuid
MEDIANET_TV_DEVICE_PRODUCT_ID=your_medianet_tv_device_product_uuid
CLASSIFICATION_ID=your_classification_uuid
CURRENCY_CODE=MVR
PAYMENT_TERMS_ID=your_payment_terms_uuid
PAYMENT_TYPE_ID=your_payment_type_uuid
CRM_SALES_MODEL_NAME=Retail
# Outbound CRM HTTP timeout (ms)
CRM_REQUEST_TIMEOUT_MS=60000

# Wallet — auto-credit without real payment (local dev only, explicit opt-in)
# Never set true in production. Ignored when BML_ENABLED=true.
WALLET_AUTO_COMPLETE_TOPUP=false
# GST included in the payment total — extracted as total / (1 + rate) * rate (0.08 = 8%)
WALLET_GST_RATE=0.08
WALLET_MIN_TOPUP=100

# BML Connect payment gateway (Bank of Maldives)
# Card details are collected on BML's hosted page — never on this server.
BML_ENABLED=false
BML_API_BASE_URL=https://api.merchants.bankofmaldives.com.mv
# v1 = legacy JWT + SHA1 signature (/public/transactions), v2 = sk_ API key (/public/v2/transactions)
BML_API_MODE=v1
# V1: JWT from merchant portal (Authorization header)
BML_AUTH_TOKEN=
# Required in production for webhook signature verification
BML_API_KEY=
BML_APP_ID=
BML_DEVICE_ID=medianet-voucher
BML_APP_VERSION=medianet-voucher/1.0
BML_SIGN_METHOD=sha1
# Optional: mpgs, debit_credit_card, alipay, etc.
BML_PROVIDER=
BML_LOCALE=en
# Frontend return URL after payment (must match merchant portal allowed URLs)
BML_REDIRECT_URL=http://localhost:5173/operator/wallet/payment/return
# Public HTTPS URL for BML webhooks (required in production)
BML_WEBHOOK_URL=
